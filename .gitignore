# Generated folders — contents are per-customer, only .gitkeep is tracked
generated/build-state/*
!generated/build-state/.gitkeep
generated/prototype/*
!generated/prototype/agents/
generated/prototype/agents/*
!generated/prototype/agents/specialists/
!generated/prototype/agents/specialists/.gitkeep
!generated/prototype/agents/knowledge/
!generated/prototype/agents/knowledge/.gitkeep

# Per-customer spec — every build overwrites this with a specific customer's
# data (name, branding, agents, seed data). Only spec_example.yaml (a
# generic Contoso reference) is tracked. Backups like spec.yaml.bak-* from
# @reset are also local-only.
/spec.yaml
spec.yaml.bak-*

# Deployment history — local reference only, not committed
deploy-history/

# azd
.azure/

# Python
__pycache__/
*.pyc
*.pyo
.env

# Temp infra artifacts
infra-temp/

# Local runtime / debug captures
app-logs.json
*.log
