# ai-prototype-accelerator — Environment Variables Sample
# Copy to .env for local development. Never commit .env to source control.
# Values are normally injected by the Container App from Bicep outputs; this file
# is only for running backend/main.py locally against deployed Azure resources.

# ── Azure Identity (user-assigned Managed Identity) ───────────────────────────
AZURE_CLIENT_ID=                    # MI client ID (GUID). Required by DefaultAzureCredential.

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Project endpoint for AIProjectClient (azure-ai-projects). Format:
#   https://{account}.services.ai.azure.com/api/projects/{project}/
AZURE_AI_PROJECT_ENDPOINT=

# ── Azure AI Search (Foundry IQ) ──────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=              # https://{name}.search.windows.net
AZURE_SEARCH_INDEX=                 # Index name (defaults to manifest value if unset)

# ── Azure Storage (Blob) ──────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=         # Storage account name (not full URL)

# ── Azure Cosmos DB (NoSQL, AAD-only) ─────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=              # https://{account}.documents.azure.com:443/
AZURE_COSMOS_DATABASE=              # Database name (defaults to manifest value if unset)

# ── Branding (spec.yaml Section 2 — all have manifest-driven defaults) ────────
CUSTOMER_NAME=
AGENT_NAME=
PRIMARY_COLOR=                      # Hex color (e.g. #0078D4)
ACCENT_COLOR=                       # Hex color (e.g. #50E6FF)
FONT_FAMILY=
LOGO_URL=                           # Full URL or /assets/... path to customer logo
WELCOME_MESSAGE=
USE_CASE_TITLE=

# ── Frontend behaviour ────────────────────────────────────────────────────────
PROTOTYPE_RESET=true                # "true" enables POST /admin/reset

# ── Observability ─────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=   # From Application Insights resource
